# Binance Futures API credentials
# Get testnet keys from https://testnet.binancefuture.com/ (login with Google -> API Key tab)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
# Set to "true" to use testnet (https://testnet.binancefuture.com), "false" for production
BINANCE_TESTNET=true

# Telegram bot (optional - skip to disable Telegram interface)
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk management defaults (can be overridden per command)
# Percent of account equity to risk per trade (e.g. 1.0 = 1%)
RISK_PER_TRADE_PCT=1.0
# Maximum simultaneous open positions
MAX_OPEN_POSITIONS=5
# Daily loss circuit breaker as percent of starting-day equity (e.g. 5.0 = 5%)
MAX_DAILY_LOSS_PCT=5.0
# Default leverage applied when opening a new symbol
DEFAULT_LEVERAGE=5
# Require every entry to include a stop-loss price (recommended: true)
REQUIRE_STOP_LOSS=true
